# ------------------------------------------------------------------
# ClassOps - .gitignore
# Comprehensive ignore rules for Python (Flask) backend + React/Vue frontend.
# ------------------------------------------------------------------

# ---------- Python / backend ----------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
.installed.cfg
*.manifest
*.spec

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.htmlcov/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
instance/
.python-version

# Secrets & environment files (never commit)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
client_secret.json
GOOGLE_CLIENT_SECRETS.json
*.pem
*.key
*.p12

# Database / runtime artifacts
*.db
*.sqlite
*.sqlite3

# ---------- Frontend / Node ----------
node_modules/
frontend/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
npm-shrinkwrap.json
*.tsbuildinfo
dist-ssr/
.vite/
.eslintcache
*.local
backend/dist/
frontend/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Editors / IDEs ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.~tmp
~$*

# ---------- Project-specific ----------
config.bat
