APP_ENV=development
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
REDIRECT_URI=http://localhost:5000/api/auth/google/callback

FLASK_SECRET_KEY=change-me
# SECRET_KEY is also supported for cloud platforms that use this naming.
SECRET_KEY=change-me
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

IS_LOCAL=true
DYNAMODB_ENDPOINT_URL=http://localhost:8000
DYNAMODB_TABLE=ClassOps_Data
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Cloud OAuth options:
# Option 1: include client_secret.json in the deployed Backend directory.
# Option 2: set GOOGLE_CLIENT_SECRETS_JSON to the full Google OAuth JSON.
# Option 3: set GOOGLE_CLIENT_SECRETS_B64 to a base64-encoded Google OAuth JSON.
# Option 4: set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.
# GOOGLE_CLIENT_SECRETS_JSON=
# GOOGLE_CLIENT_SECRETS_B64=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloud production example:
# APP_ENV=production
# BASE_URL=https://your-backend.example.com
# FRONTEND_URL=https://your-frontend.example.com
# CORS_ORIGINS=https://your-frontend.example.com,https://your-backend.example.com
# REDIRECT_URI=https://your-backend.example.com/api/auth/google/callback
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=None
# IS_LOCAL=false
# DYNAMODB_TABLE=ClassOps_Data
# AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=your-cloud-access-key
# AWS_SECRET_ACCESS_KEY=your-cloud-secret-key
