# --- ENVIRONMENT MODE ---
# Set to 'true' to use local DynamoDB in Docker. Set to 'false' for AWS Cloud.
IS_LOCAL=true

# --- AWS / DYNAMODB CONFIG ---
# For LOCAL: These can be anything (e.g., 'local')
# For PRODUCTION: These MUST be your real AWS credentials
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
DYNAMODB_TABLE=ClassOps_Data

# Local endpoint for DynamoDB (used only if IS_LOCAL=true)
# Use 'http://localhost:8000' if running backend on your host machine
# Use 'http://dynamodb-local:8000' if running backend inside Docker Compose
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# --- APP CONFIG ---
FLASK_SECRET_KEY=super_secret_dev_key
GEMINI_API_KEY=your_gemini_api_key_here

# --- COLLEGE INFO ---
QP_COLLEGE_NAME="JERUSALEM COLLEGE OF ENGINEERING"
QP_COLLEGE_ADDRESS="CHENNAI - 600100"
QP_AFFILIATION="An Autonomous Institution, Affiliated to Anna University, Chennai"
QP_ACADEMIC_YEAR="Academic Year 20XX-20XX (Odd / Even Semester)"
QP_ASSESSMENT="[Assessment Test]"
QP_COURSE_CODE="[SUBJECT CODE]"
QP_DATE="[current_date]"
QP_TIME="08.30 a.m.-10.00 a.m. FN"
QP_MAX_MARKS="50"
